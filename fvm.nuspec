<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>fvm</id>
    <version>$version$</version>
    <title>Flutter Version Management (FVM)</title>
    <authors>Leo Farias and contributors</authors>
    <owners>leochocolatey</owners>
    <projectUrl>https://github.com/conceptadev/fvm</projectUrl>
    <packageSourceUrl>https://github.com/conceptadev/fvm</packageSourceUrl>
    <projectSourceUrl>https://github.com/conceptadev/fvm</projectSourceUrl>
    <bugTrackerUrl>https://github.com/conceptadev/fvm/issues</bugTrackerUrl>
    <licenseUrl>https://github.com/conceptadev/fvm/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <docsUrl>https://fvm.app</docsUrl>
    <tags>fvm flutter versions sdk</tags>
    <summary>Flutter SDK version management</summary>
    <description>Flutter Version Management (FVM) helps teams maintain consistent app builds by managing and referencing Flutter SDK versions on a per-project basis.</description>
    <releaseNotes>https://github.com/conceptadev/fvm/blob/main/CHANGELOG.md</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
